<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Applies a saved theme choice before first paint, so there is no
       flash of the wrong theme. Must run synchronously, before main.css
       is applied — kept inline and tiny on purpose. -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      } catch (e) {}
    })();
  </script>

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="canonical" href="https://timurmanjosov.com{{ page.url }}" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://timurmanjosov.com{{ page.url }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:image" content="https://timurmanjosov.com/assets/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogImageAlt | default(description) }}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="de_DE" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="https://timurmanjosov.com/assets/images/og-image.png" />
  <meta name="twitter:image:alt" content="{{ ogImageAlt | default(description) }}" />

  <!-- Favicon: SVG for modern browsers, sized PNGs as fallback, plus iOS home screen -->
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/images/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/assets/images/favicon-16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />

  <meta name="color-scheme" content="dark light" />

  <!-- Self-hosted variable fonts: preload so text renders in the final
       typeface without a layout-shifting swap once main.css is parsed. -->
  <link rel="preload" href="/assets/fonts/space-grotesk-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/inter-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/jetbrains-mono-variable-latin.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="stylesheet" href="/styles/reset.css" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body>
  <canvas id="system-canvas" aria-hidden="true"></canvas>

  <a class="skip-link" href="#main-content" data-en="Skip to content" data-de="Zum Inhalt springen"
    >Skip to content</a
  >

  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/scripts/system.js" defer></script>
  <script src="/scripts/main.js" defer></script>
</body>
</html>
