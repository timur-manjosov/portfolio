---
import CategoryNav from "../../../components/CategoryNav.astro";
import PostList from "../../../components/PostList.astro";
import { LANGS, type Lang } from "../../../i18n/ui";
import { localePath, useTranslations } from "../../../i18n/utils";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { allPosts, forListing } from "../../../lib/content";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = forListing(await allPosts(), lang);
---

<BaseLayout
  lang={lang}
  title={t("blog.title")}
  description={t("blog.description")}
  section="blog"
  alternates={{ de: "/de/blog/", en: "/en/blog/" }}
>
  <div class="container page">
    <header class="page-header">
      <h1>{t("blog.title")}</h1>
      <p>{t("blog.description")}</p>
    </header>

    <CategoryNav lang={lang} posts={posts} current="all" />

    <section class="section section--tight" aria-labelledby="all-posts">
      <h2 id="all-posts" class="visually-hidden">{t("home.allPosts")}</h2>
      <PostList lang={lang} posts={posts} byYear />
    </section>
    <p class="section-footer">
      <a href={localePath(lang, "blog/tags/")}>{t("blog.allTags")}</a>
      · <a href={localePath(lang, "blog/archive/")}>{t("blog.archive")}</a>
      · <a href={localePath(lang, "feed.xml")}>{t("nav.feed")}</a>
    </p>
  </div>
</BaseLayout>
