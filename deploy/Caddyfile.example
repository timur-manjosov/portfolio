# timurmanjosov.com, Caddy site block (example / review copy).
# Generated by tools/caddy-site-block.mjs from deploy/site-config.json.
# The live server config is /etc/caddy/Caddyfile; deploy/stage.sh builds a
# full proposal from it (only this block is replaced), see docs/DEPLOY.md.

# BEGIN timurmanjosov.com, generated by tools/caddy-site-block.mjs from deploy/site-config.json
# Canonical host: www redirects to the apex (before: both served the same
# content, i.e. duplicate URLs).
www.timurmanjosov.com {
	redir https://timurmanjosov.com{uri} 308
}

timurmanjosov.com {
	# Release directory; deploy/apply-on-server.sh flips this symlink.
	root * /srv/www/timurmanjosov.com/current
	encode zstd gzip

	# Security headers. Strict CSP without 'unsafe-inline' and, unlike the
	# previous config, without a script hash: the theme-init script is an
	# external file now (docs/adr/0001-stack.md).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Caching. Astro puts every CSS/JS/font file under /_astro/ with a content
	# hash in its name, so those can be cached forever. Everything else is
	# revalidated (file_server sends ETag/Last-Modified), except the language
	# door below, which must never be cached.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /_astro/* /
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	# Language door: / answers 302 by the FIRST Accept-Language
	# entry (browsers sort by preference): /de/ if it matches, else
	# /en/ (also for "*" and a missing header). Only / does this;
	# every /de/… and /en/… URL is served as is. The response depends on a
	# request header, so it carries Vary and is never cached.
	@door path /
	header @door {
		Cache-Control "no-store"
		Vary "Accept-Language"
	}
	@door_match {
		path /
		header_regexp Accept-Language "(?i)^de(-[a-z0-9]+)*([;, ]|$)"
	}
	@door_default {
		path /
		not header_regexp Accept-Language "(?i)^de(-[a-z0-9]+)*([;, ]|$)"
	}
	redir @door_match /de/ 302
	redir @door_default /en/ 302

	# Web Key Directory for the OpenPGP key (only relevant once a key is
	# published under /.well-known/openpgpkey/, see docs/DEPLOY.md).
	@wkd path /.well-known/openpgpkey/*
	header @wkd Access-Control-Allow-Origin "*"

	# Old URLs → new URLs (redirect table: deploy/site-config.json,
	# documented in docs/DEPLOY.md). 301 = permanent move, 302 = convenience
	# path whose language target may change later.
	redir /index.html / 301
	redir /lab /en/projects/ 301
	redir /lab/ /en/projects/ 301
	redir /lab/index.html /en/projects/ 301
	redir /assets/images/og-image.png /images/og-default.png 301
	redir /assets/images/favicon.svg /favicon.svg 301
	redir /assets/images/favicon-32.png /images/favicon-32.png 301
	redir /assets/images/favicon-16.png /images/favicon-16.png 301
	redir /assets/images/apple-touch-icon.png /apple-touch-icon.png 301
	redir /about /en/about/ 302
	redir /about/ /en/about/ 302
	redir /projects /en/projects/ 302
	redir /projects/ /en/projects/ 302
	redir /blog /en/blog/ 302
	redir /blog/ /en/blog/ 302
	redir /now /en/now/ 302
	redir /now/ /en/now/ 302
	redir /uses /en/uses/ 302
	redir /uses/ /en/uses/ 302
	redir /links /en/links/ 302
	redir /links/ /en/links/ 302
	redir /contact /en/contact/ 302
	redir /contact/ /en/contact/ 302
	redir /search /en/search/ 302
	redir /search/ /en/search/ 302
	redir /privacy /en/privacy/ 302
	redir /privacy/ /en/privacy/ 302
	redir /de/projects/octo /de/projects/ 301
	redir /de/projects/octo/ /de/projects/ 301
	redir /en/projects/octo /en/projects/ 301
	redir /en/projects/octo/ /en/projects/ 301
	redir /feed.xml /en/feed.xml 301
	redir /rss.xml /en/feed.xml 301

	file_server

	# Helpful 404 pages, per language; the status stays 404.
	handle_errors 404 {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "DENY"
			Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
			Cross-Origin-Opener-Policy "same-origin"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			-Server
		}
		header Cache-Control "no-store"
		@de path /de/*
		rewrite @de /de/404/index.html
		@en path /en/*
		rewrite @en /en/404/index.html
		@other not path /de/* /en/*
		rewrite @other /404.html
		file_server
	}
}
# END timurmanjosov.com
