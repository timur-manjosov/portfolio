---
import type { Lang } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";
import LangSwitch from "./LangSwitch.astro";

export type Section = "home" | "about" | "projects" | "blog" | "now" | "contact" | "search" | "other";

interface Props {
  lang: Lang;
  section: Section;
  alternates: Partial<Record<Lang, string>>;
  fallback?: string | undefined;
}

const { lang, section, alternates, fallback } = Astro.props;
const t = useTranslations(lang);

const items: { id: Section; label: string; href: string }[] = [
  { id: "about", label: t("nav.about"), href: localePath(lang, "about/") },
  { id: "projects", label: t("nav.projects"), href: localePath(lang, "projects/") },
  { id: "blog", label: t("nav.blog"), href: localePath(lang, "blog/") },
  { id: "now", label: t("nav.now"), href: localePath(lang, "now/") },
  { id: "contact", label: t("nav.contact"), href: localePath(lang, "contact/") },
];
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="brand" href={localePath(lang)} aria-current={section === "home" ? "page" : undefined}>
      <span class="brand__mark" aria-hidden="true">TM</span>
      <span>Timur Manjosov</span>
    </a>
    <nav class="site-nav" aria-label={t("nav.label")}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.id === section ? "page" : undefined}>
                {item.label}
                {item.id === section && <span class="nav-indicator" aria-hidden="true"></span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-tools">
      <a
        class="icon-button"
        href={localePath(lang, "search/")}
        aria-current={section === "search" ? "page" : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="visually-hidden">{t("nav.search")}</span>
      </a>
      <button type="button" class="icon-button theme-toggle" data-theme-toggle hidden aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <span class="visually-hidden">{t("theme.toDark")}</span>
      </button>
      <LangSwitch lang={lang} alternates={alternates} fallback={fallback} />
    </div>
  </div>
</header>

<script>
  import "../scripts/theme.ts";
</script>
