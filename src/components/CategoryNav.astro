---
/**
 * Category filter of the blog (R6-D6): one chip per category that has posts,
 * with its count, plus "All". Each chip is a link to the category page, so
 * filtering works without JS; the current one carries aria-current.
 */
import type { Lang } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";
import type { Parsed } from "../lib/content";
import { allCategories, categoryUrl } from "../lib/taxonomy";

interface Props {
  lang: Lang;
  /** The posts listed in this language (forListing). */
  posts: Parsed<"blog">[];
  /** "all" or a category id. */
  current: string;
}

const { lang, posts, current } = Astro.props;
const t = useTranslations(lang);
const categories = (await allCategories())
  .map((c) => ({ c, n: posts.filter((p) => p.entry.data.category.id === c.id).length }))
  .filter((x) => x.n > 0);
---

<nav class="category-nav" aria-label={t("blog.categories")}>
  <ul class="chip-row">
    <li>
      <a class="filter-chip" href={localePath(lang, "blog/")} aria-current={current === "all" ? "page" : undefined}>
        {t("blog.allCategories")} <span class="filter-chip__count">{posts.length}</span>
      </a>
    </li>
    {
      categories.map(({ c, n }) => (
        <li>
          <a class="filter-chip" href={categoryUrl(lang, c.id)} aria-current={current === c.id ? "page" : undefined}>
            {c.data.label[lang]} <span class="filter-chip__count">{n}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
