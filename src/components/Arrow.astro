---
/**
 * Action indicator (R4-D3): every clickable box and every "more" link ends in
 * one. A plain arrow for pages of this site, a diagonal one for links that
 * leave it. Decorative: the link text says where it goes. Drawn from the
 * icon set (Icon.astro).
 */
import Icon from "./Icon.astro";

interface Props {
  external?: boolean;
}
const { external = false } = Astro.props;
---

<Icon name={external ? "external" : "arrow"} class={external ? "arrow arrow--external" : "arrow"} />
