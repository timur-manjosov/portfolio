{
  "$comment": "Single source for security headers and redirects. Used by tools/caddy-site-block.mjs (Caddyfile.example / Caddyfile.proposed) and by tools/serve.mjs (the local test server that check-browser.mjs runs against). Change it here, regenerate, never edit the generated Caddy block by hand.",
  "headers": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "publish": {
    "$comment": "npm run publish (tools/publish.mjs, docs/PUBLISHING.md). branches: the branches a publish may run from (others need --any-branch). keep: how many published releases stay on the server for --rollback (2-50). The SSH target is never stored here (public repository): pass --target <ssh-target> or set PUBLISH_SSH_TARGET.",
    "branches": ["main"],
    "keep": 5
  },
  "languageDoor": {
    "$comment": "Only `path` redirects by language (docs/DECISIONS.md R2-D2). The first Accept-Language entry decides: if it matches `acceptLanguage` (case-insensitive; here German: de, de-DE, de-AT, DE, …) → `match`; anything else, `*` or no header → `default`. Browsers send their languages sorted by priority, so the first entry is the preferred one. To make German the default: acceptLanguage `^en(-[a-z0-9]+)*([;, ]|$)`, match `/en/`, default `/de/`. Then run `npm run caddy:example`.",
    "path": "/",
    "acceptLanguage": "^de(-[a-z0-9]+)*([;, ]|$)",
    "match": "/de/",
    "default": "/en/",
    "status": 302,
    "tests": [
      ["de", "/de/"],
      ["de-DE,de;q=0.9,en;q=0.8", "/de/"],
      ["en-US,en;q=0.9,de;q=0.8", "/en/"],
      ["fr-FR", "/en/"],
      ["-", "/en/"],
      ["*", "/en/"],
      ["de-AT", "/de/"],
      ["DE", "/de/"],
      ["de-CH,fr;q=0.5", "/de/"],
      ["en", "/en/"],
      ["dsb-DE,de;q=0.8", "/en/"],
      ["fr-FR,de;q=0.9", "/en/"]
    ]
  },
