---
/**
 * Home (R6-D7): who and what in one sentence, one primary action, the site as
 * a small network of destinations ("Knotenpunkt", Hub.astro); below it the
 * newest posts as a list, the current projects as cards, and /now as one
 * quiet strip (findings B5, B6).
 */
import Arrow from "../../components/Arrow.astro";
import Hub from "../../components/Hub.astro";
import PostList from "../../components/PostList.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { profile } from "../../data/site";
import { LANGS, type Lang } from "../../i18n/ui";
import { formatDate, isoDate, localePath, useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allPages, allPosts, allProjects, forListing } from "../../lib/content";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const listedPosts = forListing(await allPosts(), lang);
const posts = listedPosts.slice(0, 3);
// "Current" = not archived/paused, in the overview's order (featured, order, updated).
const current = forListing(await allProjects(), lang).filter((p) =>
  ["active", "in-development", "maintained"].includes(p.entry.data.stage),
);
const projects = current.slice(0, 4);
const now = (await allPages()).find((p) => p.lang === lang && p.slug === "now");
---

<BaseLayout
  lang={lang}
  description={profile.summary[lang]}
  section="home"
  alternates={{ de: "/de/", en: "/en/" }}
  xDefault="/"
>
  <div class="container container--wide">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__text">
        <p class="eyebrow">{t("hero.eyebrow")}</p>
        <h1 id="hero-title" class="hero__title gradient-text">Timur Manjosov</h1>
        <p class="hero__claim">{t("site.tagline")}</p>
        <p class="hero__lead">{t("hero.lead")}</p>
        <div class="actions">
          <a class="btn btn--primary" href={localePath(lang, "about/")}>{t("nav.about")}</a>
          <a class="btn btn--text" href={localePath(lang, "blog/")}>
            {t("hero.readBlog")}
            <Arrow />
          </a>
        </div>
      </div>
      <Hub lang={lang} posts={listedPosts.length} projects={current.length} nowUpdated={now?.entry.data.updated} />
    </section>

    <section class="home-section" aria-labelledby="posts-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t("nav.blog")}</p>
          <h2 id="posts-title">{t("home.latestPosts")}</h2>
        </div>
        {
          posts.length > 0 && (
            <a class="section-head__link" href={localePath(lang, "blog/")}>
              {t("home.allPosts")}
              <Arrow />
            </a>
          )
        }
      </div>
      <PostList lang={lang} posts={posts} />
    </section>

    <section class="home-section" aria-labelledby="projects-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t("nav.projects")}</p>
          <h2 id="projects-title">{t("home.currentProjects")}</h2>
        </div>
        <a class="section-head__link" href={localePath(lang, "projects/")}>
          {t("home.allProjects")}
          <Arrow />
        </a>
      </div>
      <ul class="card-grid" data-count={projects.length}>
        {projects.map((p) => <ProjectCard lang={lang} project={p} />)}
      </ul>
    </section>

    {
      now && (
        <section class="home-section" aria-labelledby="now-title">
          <article class="now-strip">
            <p class="eyebrow">/now</p>
            <h2 id="now-title" class="now-strip__title">
              {t("home.now")}
            </h2>
            <p class="now-strip__text">{now.entry.data.summary ?? now.entry.data.description}</p>
            <p class="now-strip__foot">
              <span class="meta">
                {t("now.updated")} <time datetime={isoDate(now.entry.data.updated)}>{formatDate(now.entry.data.updated, lang)}</time>
              </span>
              <a class="section-head__link" href={localePath(lang, "now/")}>
                {t("nav.now")}
                <Arrow />
              </a>
            </p>
          </article>
        </section>
      )
    }
  </div>
</BaseLayout>
